--- !u!114 &1577690111
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1577690109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2b3f73a430d2e241a5cf39a9619c51f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 602197684}
  sceneDialogue:
  - speakerName: Witch
    text: This is an example sentence. Press any key to advance.
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: I can ask you a question?
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: And I can make a statement.
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: Now I'm surprised!
    portrait: {fileID: 1819588790531360141, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: 'And this is a long paragraph to see how everything looks in the box together.
      Does it sound okay with a mix of punctuation? '
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: I wonder. I hope yes! I'm very excited to be speaking. This game is going
      to be so fun! Do you agree? I agree!
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: Okay bye bye now! Bye bye!
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
