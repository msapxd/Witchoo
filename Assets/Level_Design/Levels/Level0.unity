      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[5].text
      value: Hahaha of course, what would I do without my two trusty familiars!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[6].text
