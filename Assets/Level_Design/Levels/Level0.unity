MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 669310956}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2b3f73a430d2e241a5cf39a9619c51f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 4039849585573274243}
  sceneDialogue:
  - speakerName: Witch
    text: Oh hello dear! I'm so glad you're here!
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: 'I was setting up for my Halloween party, when one of my spells backfired! '
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: Now the whole place is a mess, and the guests are gonna come in an hour!!!
    portrait: {fileID: 1819588790531360141, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: But with your help, we'll be done in no time. So whaddya say? Will you
      help me?
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
  - speakerName: Witch
    text: Let's do it!
    portrait: {fileID: 785852524366872568, guid: 0698300c0e4a8e544aee05459d4b0022, type: 3}
