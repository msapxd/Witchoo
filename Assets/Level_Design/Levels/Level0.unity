    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: dialogueManager
      value: 
      objectReference: {fileID: 1949933241}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[0].text
      value: Let's get these vines out of the way!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[1].text
      value: The guests are gonna come in an hour for the Halloween party, how can
        I host when the house looks like this?!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[2].text
      value: Don't worry! Cat and I will help you get this place in shape in no time!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[3].text
      value: Right cat?
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[4].text
      value: Z z z z z z z
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[5].text
      value: Hahaha of course, what would I do without my two trusty familiars!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[6].text
      value: Alright guys, let's do this!
      objectReference: {fileID: 0}
    - target: {fileID: 1206026459916132465, guid: 48244b7de50a9d0448b0a19b322b3016, type: 3}
      propertyPath: sceneDialogue.Array.data[7].text
      value: Alright guys, let's do this!
      objectReference: {fileID: 0}
